{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm build)",
      "Bash(pnpm format:check)",
      "Bash(pnpm --filter @conversa/api test)",
      "Bash(pnpm --filter @conversa/api test *)",
      "Bash(pnpm --filter @conversa/api lint)",
      "Bash(pnpm --filter @conversa/api lint *)",
      "Bash(pnpm --filter @conversa/api typecheck)",
      "Bash(pnpm --filter @conversa/api typecheck *)",
      "Bash(pnpm --filter @conversa/api build)",
      "Bash(pnpm --filter @conversa/api build *)",
      "Bash(pnpm --filter @conversa/web test)",
      "Bash(pnpm --filter @conversa/web test *)",
      "Bash(pnpm --filter @conversa/web lint)",
      "Bash(pnpm --filter @conversa/web lint *)",
      "Bash(pnpm --filter @conversa/web typecheck)",
      "Bash(pnpm --filter @conversa/web typecheck *)",
      "Bash(pnpm --filter @conversa/web build)",
      "Bash(pnpm --filter @conversa/web build *)",
      "Bash(pnpm --filter @conversa/shared test)",
      "Bash(pnpm --filter @conversa/shared test *)",
      "Bash(pnpm --filter @conversa/shared lint)",
      "Bash(pnpm --filter @conversa/shared lint *)",
      "Bash(pnpm --filter @conversa/shared typecheck)",
      "Bash(pnpm --filter @conversa/shared typecheck *)",
      "Bash(pnpm --filter @conversa/shared build)",
      "Bash(pnpm --filter @conversa/shared build *)",
      "Bash(pnpm --filter @conversa/api test:integration)",
      "Bash(pnpm --filter @conversa/api test:integration *)",
      "Bash(pnpm --filter @conversa/api db:generate)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "mcp__mola-ui"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./secrets/**)",
      "Bash(cat .env)",
      "Bash(cat .env *)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": ["mola-ui"]
}
