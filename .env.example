# Conversa configuration. Copy to .env and fill in. Never commit .env.
# Generate the secrets with: pnpm secrets:generate

NODE_ENV=development
LOG_LEVEL=info

# Public URL people open in the browser. Webhooks and OAuth redirects use it.
APP_URL=http://localhost:3000
# Where the web server reaches the API (inside Docker: http://api:4000).
API_INTERNAL_URL=http://localhost:4000
API_PORT=4000

DATABASE_URL=postgresql://conversa:conversa@localhost:5432/conversa
REDIS_URL=redis://localhost:6379

# 48+ random bytes. Signs OAuth state, MFA challenges and visitor hashes.
SECRET_KEY=
# 32 random bytes, base64. Encrypts provider tokens and API keys at rest.
# To rotate, move the old key to ENCRYPTION_KEYS_PREVIOUS (comma separated).
ENCRYPTION_KEY=
ENCRYPTION_KEYS_PREVIOUS=

# invite_only: after the first account, people join only by invitation.
# open: anyone who can reach the instance can sign up.
SIGNUP_MODE=invite_only

# How client IPs are read behind proxies: none, cloudflare, or a hop count.
TRUST_PROXY=none

# Outgoing mail for invitations and password resets. Optional.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Conversa <no-reply@localhost>"

# Cloudflare Turnstile on sign-up, sign-in and password reset. Optional.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Instagram API with Instagram Login (your Meta app). See docs/instagram.md.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v24.0
